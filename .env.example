# --- Anthropic (server only) ---
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Supabase ---
# Project URL and publishable ("anon") key: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Transaction pooler connection string (port 6543). Server only, keep secret.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
